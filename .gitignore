# Secrets: never commit your real keys
.env

# Local Python environment and caches
.venv/
__pycache__/
.pytest_cache/

# Raw data you download yourself (can be large or licensed)
data/raw/

# Backtest output is regenerated by running the engine.
# Ignore every per-signal results folder but keep the empty results/ folder.
backtesting/results/*/
!backtesting/results/.gitkeep
